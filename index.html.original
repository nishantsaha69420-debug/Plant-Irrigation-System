<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FloraAI | Cloud Dashboard</title>
  <style>
    :root {
      --bg: #0f172a; --card: rgba(30, 41, 59, 0.85); --accent: #38bdf8;
      --green: #10b981; --red: #ef4444; --text: #f8fafc; --muted: #94a3b8;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { background: radial-gradient(circle at top, #1e293b, #0f172a); color: var(--text); min-height: 100vh; display: flex; justify-content: center; align-items: center; padding: 16px; }
    .dashboard { width: 100%; max-width: 420px; background: var(--card); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.08); border-radius: 24px; padding: 24px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .title h1 { font-size: 20px; font-weight: 700; }
    .badge { font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 99px; background: rgba(16, 185, 129, 0.15); color: var(--green); border: 1px solid rgba(16, 185, 129, 0.3); }
    .gauge-card { background: rgba(15, 23, 42, 0.6); border-radius: 18px; padding: 20px; text-align: center; margin-bottom: 16px; }
    .moisture-pct { font-size: 46px; font-weight: 800; color: var(--accent); }
    .btn { display: block; width: 100%; padding: 14px; margin: 10px 0; font-size: 16px; font-weight: bold; border: none; border-radius: 8px; cursor: pointer; color: white; }
    .on { background: #27ae60; } .off { background: #e74c3c; } .mode { background: #2980b9; }
  </style>
</head>
<body>
  <div class="dashboard">
    <div class="header">
      <div class="title"><h1>🌱 FloraAI Cloud</h1></div>
      <div class="badge">ONLINE</div>
    </div>
    <div class="gauge-card">
      <div class="moisture-pct" id="moisture-val">--</div>
      <p style="color:var(--muted); margin-top:5px;">Live Cloud Telemetry</p>
    </div>
    <button class="btn mode" onclick="toggleMode()">Toggle Mode</button>
    <button class="btn on" onclick="setPump('on')">Turn Pump ON</button>
    <button class="btn off" onclick="setPump('off')">Turn Pump OFF</button>
  </div>

  <!-- Firebase SDKs -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import { getDatabase, ref, onValue, set } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js";

    // PASTE YOUR FIREBASE CONFIG HERE FROM FIREBASE CONSOLE
    const firebaseConfig = {
      databaseURL: "https://auto-irrigation-system-8225b-default-rtdb.asia-southeast1.firebasedatabase.app/"
    };

    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);

    // Listen to live telemetry from ESP32
    onValue(ref(db, 'telemetry'), (snapshot) => {
      const data = snapshot.val();
      if (data) {
        document.getElementById('moisture-val').innerText = data.moisture;
      }
    });

    window.setPump = function(state) {
      set(ref(db, 'commands'), { mode: 'manual', pump: state });
    }

    window.toggleMode = function() {
      set(ref(db, 'commands'), { mode: 'auto', pump: 'off' });
    }
  </script>
</body>
</html>